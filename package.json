{
  "name": "slack-copy",
  "version": "1.0.0",
  "description": "Convert Markdown to Slack mrkdwn and put it on the clipboard",
  "type": "module",
  "bin": {
    "slack-copy": "scripts/index.ts"
  },
  "files": [
    "scripts/index.ts"
  ],
  "scripts": {
    "test": "node test.ts && node evals/check.ts",
    "typecheck": "tsc --noEmit",
    "evals": "node evals/check.ts"
  },
  "devDependencies": {
    "@types/node": "^26",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=26"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finnjanssens/slack-copy.git"
  },
  "keywords": [
    "slack",
    "markdown",
    "mrkdwn",
    "clipboard",
    "cli"
  ]
}
